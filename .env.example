# 环境变量模板：复制为 .env 后填入真实值（.env 已被 .gitignore 排除，不会入库）
# 使用方式：cp .env.example .env
#
# 本项目使用 OpenAI 兼容协议，不绑定任何特定服务商。
# 凡是兼容 Chat Completions 接口的服务都能接入，换服务商只需改下面三个值。

# ---------------------------------------------------------------------------
# 1. 接口地址（必填）
#
# 常见服务商示例（按需取用其一）：
#   https://api.deepseek.com/v1
#   https://api.moonshot.cn/v1
#   https://open.bigmodel.cn/api/paas/v4
#   https://dashscope.aliyuncs.com/compatible-mode/v1
#   http://localhost:11434/v1            （本地 Ollama）
#   http://127.0.0.1:8000/v1（vLLM 自建）
#
# 本地部署若不需要鉴权，可留空。
# ---------------------------------------------------------------------------
OPENAI_BASE_URL=

# ---------------------------------------------------------------------------
# 2. API 密钥（必填）
#
# 填服务商的 API Key。变量名必须保持 OPENAI_API_KEY，这是 OpenAI 客户端库的约定。
# 本地部署若不需要鉴权，可留空。
# ---------------------------------------------------------------------------
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# 3. 模型名（必填）
#
# 填该服务商实际提供的模型名。示例：deepseek-flash、moonshot-v1-8k、
# glm-4-flash、qwen-plus、qwen2.5:7b等。
#
# 注意：必须是你的账号实际有权限调用的模型，填错或已下线的模型会直接报错。
# 可用以下命令查询当前账号可用的模型列表：
#
#   python -c "import os;from dotenv import load_dotenv;load_dotenv();\
# from openai import OpenAI;print([m.id for m in OpenAI(\
# api_key=os.getenv('OPENAI_API_KEY'),\
# base_url=os.getenv('OPENAI_BASE_URL')).models.list().data])"
# ---------------------------------------------------------------------------
MODEL=