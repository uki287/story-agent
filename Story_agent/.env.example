# ============================================================================
# 短篇小说智能体 · 独立环境配置
#
# 本文件专供 Story_agent 使用，与项目根目录的 .env 完全独立、互不影响。
# story_llm.py 会显式按本文件所在目录加载，不向上查找其他位置的配置。
#
# 用法：把本文件复制为同目录下的 .env，再填入真实值
#     cp .env.example .env        （Windows: copy .env.example .env）
#
# 注意：.env 已被 .gitignore 排除，填好真实密钥后不会被提交。
#       切勿把真实密钥直接写进本模板文件。
# ============================================================================


# ----------------------------------------------------------------------------
# 1. 接口地址（必填）
#
# 任何兼容 OpenAI Chat Completions 协议的服务都可以接入，只需换成对应地址。
# 常见几家示例（按需取用其一）：
#
#   DeepSeek:   https://api.deepseek.com/v1
#   月之暗面:   https://api.moonshot.cn/v1
#   智谱:https://open.bigmodel.cn/api/paas/v4
#   通义千问:   https://dashscope.aliyuncs.com/compatible-mode/v1
#   本地Ollama: http://localhost:11434/v1
#   vLLM 自建:  http://127.0.0.1:8000/v1
#
# 若走本地部署且不需要鉴权，可留空：OPENAI_BASE_URL=
# ----------------------------------------------------------------------------
OPENAI_BASE_URL=https://api.deepseek.com/v1


# ----------------------------------------------------------------------------
# 2. API 密钥（必填）
#
# 填写服务商的 API Key。有的服务也沿用 OPENAI_API_KEY 这个变量名，
# 这是 OpenAI 客户端库的约定，改名会导致读取不到。
# 本地部署若无需鉴权，可留空：OPENAI_API_KEY=
# ----------------------------------------------------------------------------
OPENAI_API_KEY=在这里填入你的密钥


# ----------------------------------------------------------------------------
# 3. 模型名（可选）
#
# 填上一步那个服务商实际提供的模型名。留空则用代码默认值deepseek-flash。
# 换服务商时，通常只需同时改 BASE_URL、API_KEY、MODEL 三个值。
#
# 常见示例：
#   DeepSeek  → deepseek-flash / deepseek-chat
#   月之暗面  → moonshot-v1-8k
#   智谱      → glm-4-flash
#   通义千问  → qwen-plus
#   本地 Ollama → qwen2.5:7b / llama3.1:8b
#
# 注意：模型名必须是该账号实际有权限调用的，填错或已下线的模型会直接报错。
# 可用 `python -c "import os;from dotenv import load_dotenv;load_dotenv();\
# from openai import OpenAI;\
# print([m.id for m in OpenAI(api_key=os.getenv('OPENAI_API_KEY'),\
# base_url=os.getenv('OPENAI_BASE_URL')).models.list().data])"` 查询。
# ----------------------------------------------------------------------------
MODEL=deepseek-flash